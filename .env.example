# Copy this file to backend/.env and fill in your mf-atlas.space credentials.
# See MF-API-INTEGRATION-GUIDE.md for what these mean.

# HTTP port the Go server listens on (serves both the API and the frontend).
PORT=8080

# MongoDB connection. The docker-compose.yml at the repo root starts a local
# Mongo matching this default.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mf_demo

# --- mf-atlas.space credentials (required) ---
# Given to you by your mf-atlas onboarding contact. Base URL is the
# sandbox/production API host, e.g. https://sandbox.mf-atlas.space
# (NOT https://docs.mf-atlas.space, which is the docs site).
MF_ATLAS_BASE_URL=http://localhost:3000
MF_ATLAS_CLIENT_ID=
MF_ATLAS_CLIENT_SECRET=

# --- Webhooks (optional) ---
# Only needed if you want live push updates instead of relying on the
# built-in reconciliation poller. See README "Webhooks (optional)".
# PUBLIC_WEBHOOK_URL is informational/for your own reference; register it
# with mf-atlas via the curl command in the README.
PUBLIC_WEBHOOK_URL=
# Paste the `secret` returned (once) by POST /api/webhooks/v1/subscriptions.
MF_ATLAS_WEBHOOK_SECRET=

# How often (seconds) the background job re-checks any investor/mandate/
# order/payment stuck in a non-terminal state.
RECONCILE_INTERVAL_SECONDS=20
